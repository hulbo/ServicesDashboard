{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Services Dashboard",
  "version": "0.1.10",
  "identifier": "com.hulbo.servicesdashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Services Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "로컬 개발 서비스 대시보드",
    "longDescription": "IntelliJ 없이 Node, Spring Boot, Maven, Gradle 서비스를 한 화면에서 실행하고 로그를 확인하는 가벼운 대시보드",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2QjQzQzA3QUEwREVCOUYKUldTZjZ3MnFCenkwcHNXSEhpNTlqTmNXSloyNXhWbWxnQ1ZGSmVMcktZVmVDMkpXQ0txQUduMlUK",
      "endpoints": ["https://github.com/hulbo/ServicesDashboard/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
