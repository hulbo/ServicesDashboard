{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hulbo/ServicesDashboard/main/schema/workspace.schema.json",
  "title": "Services Dashboard 워크스페이스",
  "description": "서비스 정의 파일. 기본 위치: %APPDATA%\\ServicesDashboard\\workspaces\\<이름>.json",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "워크스페이스 이름"
    },
    "variables": {
      "$ref": "#/$defs/envMap",
      "description": "${var:NAME}으로 참조하는 변수. 다른 변수를 참조할 수 있다."
    },
    "env": {
      "$ref": "#/$defs/envMap",
      "description": "모든 서비스에 공통으로 적용되는 환경변수"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "presets": {
      "type": "array",
      "description": "실행 프리셋: 그룹과 상관없이 고른 서비스 묶음",
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "envMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "env": {
          "$ref": "#/$defs/envMap",
          "description": "그룹 안의 서비스에 적용되는 환경변수"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "고유 ID"
        },
        "name": {
          "type": "string",
          "description": "트리에 표시할 이름"
        },
        "group": {
          "type": "string",
          "description": "소속 그룹 ID"
        },
        "type": {
          "enum": [
            "npm",
            "node",
            "gradle-boot",
            "maven-boot",
            "java-main",
            "jar",
            "gradle",
            "maven",
            "shell"
          ],
          "description": "실행 타입"
        },
        "cwd": {
          "type": "string",
          "description": "작업 디렉터리. 변수 사용 가능 (예: ${var:ROOT}/front/portal)"
        },
        "env": {
          "$ref": "#/$defs/envMap"
        },
        "envFiles": {
          "$ref": "#/$defs/stringList",
          "description": ".env 형식 파일 경로 (작업 디렉터리 기준)"
        },
        "jvmArgs": {
          "$ref": "#/$defs/stringList",
          "description": "VM 옵션"
        },
        "args": {
          "$ref": "#/$defs/stringList",
          "description": "프로그램 인자"
        },
        "mainClass": {
          "type": "string",
          "description": "메인 클래스. gradle-boot는 init script, maven-boot는 -Dspring-boot.run.main-class로 전달"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "jdk": {
              "type": "string",
              "description": "JDK 홈 경로 또는 버전 별칭 (예: 17, 1.8). 이 서비스에만 JAVA_HOME으로 적용"
            },
            "node": {
              "type": "string",
              "description": "node.exe가 들어 있는 폴더 또는 버전 별칭 (예: 20)"
            },
            "maven": {
              "type": "string",
              "description": "Maven 홈 경로 또는 버전 별칭. 지정하면 Maven Wrapper보다 우선"
            }
          }
        },
        "inject": {
          "type": "object",
          "description": "자동으로 추가하는 옵션 (기본: 모두 켬)",
          "properties": {
            "utf8": {
              "type": "boolean",
              "description": "Java: -Dfile.encoding=UTF-8 등 콘솔 인코딩 옵션 추가"
            },
            "color": {
              "type": "boolean",
              "description": "Node: FORCE_COLOR=1, Spring Boot: --spring.output.ansi.enabled=always, Maven: -Dstyle.color=always"
            }
          }
        },
        "readiness": {
          "type": "object",
          "description": "준비(Ready) 감지. 없으면 타입별 기본값 (Spring Boot: 'Started … in N seconds', npm/node: 'Local: http://…' 등)",
          "properties": {
            "logPattern": {
              "type": "string",
              "description": "이 정규식과 맞는 로그 줄이 나오면 준비 완료"
            },
            "httpUrl": {
              "type": "string",
              "description": "2xx·3xx로 응답하면 준비 완료 (예: http://localhost:8080/actuator/health)"
            },
            "timeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600,
              "description": "이 시간 안에 신호가 없으면 '실행 중'으로 표시 (기본: Java 300초, 그 밖 120초)"
            },
            "disabled": {
              "type": "boolean",
              "description": "true면 준비 감지 없이 바로 '실행 중'"
            }
          }
        },
        "spring": {
          "type": "object",
          "properties": {
            "profiles": {
              "$ref": "#/$defs/stringList",
              "description": "활성 프로파일"
            }
          }
        },
        "npm": {
          "type": "object",
          "properties": {
            "script": {
              "type": "string",
              "description": "package.json scripts의 이름 (예: dev)"
            },
            "packageManager": {
              "enum": [
                "npm",
                "yarn",
                "pnpm"
              ]
            }
          }
        },
        "node": {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "description": "실행할 스크립트 파일"
            },
            "nodeArgs": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        "gradle": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "description": "Gradle 프로젝트 경로 (예: :apps:portal)"
            },
            "tasks": {
              "$ref": "#/$defs/stringList",
              "description": "gradle 타입에서 실행할 태스크"
            },
            "options": {
              "$ref": "#/$defs/stringList",
              "description": "추가 Gradle 옵션"
            },
            "daemon": {
              "type": "boolean",
              "description": "Gradle 데몬 재사용 (기본 false → --no-daemon). 켜면 빠르지만 외부 데몬에 붙으면 중지 시 앱 종료가 늦을 수 있음"
            }
          }
        },
        "maven": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "description": "-pl 에 넘길 모듈"
            },
            "goals": {
              "$ref": "#/$defs/stringList",
              "description": "maven 타입에서 실행할 골"
            },
            "options": {
              "$ref": "#/$defs/stringList",
              "description": "추가 Maven 옵션"
            }
          }
        },
        "jar": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "실행할 jar 경로"
            }
          }
        },
        "shell": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "shell": {
              "enum": [
                "cmd",
                "powershell",
                "pwsh",
                "bash"
              ]
            }
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "description": "사용 포트. 시작 전 충돌 검사와 준비 감지(포트 열림)에 쓴다"
        },
        "encoding": {
          "enum": [
            "auto",
            "utf-8",
            "cp949"
          ],
          "description": "콘솔 출력 인코딩. auto는 줄마다 UTF-8을 시도하고 실패하면 CP949로 해석"
        },
        "notes": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "description": "가져온 원본 정보 (다시 가져오기에 사용)",
          "properties": {
            "kind": {
              "enum": [
                "intellij",
                "npm",
                "gradle",
                "maven"
              ]
            },
            "root": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            }
          }
        },
        "dependsOn": {
          "$ref": "#/$defs/stringList",
          "description": "먼저 준비(실행 중)돼야 하는 서비스 ID. 순환은 저장할 때 오류"
        },
        "autoRestart": {
          "type": "object",
          "description": "비정상 종료 시 자동 재시작 (있으면 켜짐)",
          "properties": {
            "maxRetries": {
              "type": "integer",
              "minimum": 1,
              "description": "연속 재시작 최대 횟수 (기본 3, 1분 넘게 실행되면 다시 셈)"
            },
            "delaySecs": {
              "type": "integer",
              "minimum": 1,
              "description": "첫 재시작까지 대기(초, 기본 3). 재시도마다 두 배, 최대 60초"
            }
          }
        },
        "debug": {
          "type": "object",
          "description": "'디버그로 시작'할 때 설정",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "디버거 포트 (기본 Java 5005, Node 9229)"
            },
            "suspend": {
              "type": "boolean",
              "description": "Java: 디버거가 붙을 때까지 대기 (suspend=y)"
            }
          }
        },
        "javaMain": {
          "type": "object",
          "description": "java-main 클래스패스 설정",
          "properties": {
            "source": {
              "enum": [
                "gradle",
                "maven",
                "manual"
              ],
              "description": "클래스패스 출처 (기본 gradle)"
            },
            "module": {
              "type": "string",
              "description": "gradle: 프로젝트 경로(:apps:api), maven: 모듈 경로(api)"
            },
            "classpath": {
              "$ref": "#/$defs/stringList",
              "description": "manual: 클래스패스 항목"
            },
            "rebuild": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: 소스·빌드 파일이 바뀌었을 때만 빌드 (기본)"
            }
          }
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "services": {
          "$ref": "#/$defs/stringList",
          "description": "서비스 ID 목록"
        }
      }
    }
  }
}
